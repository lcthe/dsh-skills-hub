{
  "name": "@lcthe/dsh-skills-hub",
  "version": "0.2.4",
  "description": "DSH plugin for browsing, searching, inspecting, importing, uploading, and safely deleting skills across global and registered workspace directories.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "skill",
    "manager"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcthe/dsh-skills-hub.git"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "bundle": "tsdown",
    "build": "npm run clean && npm run typecheck && npm run bundle"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1"
  }
}
